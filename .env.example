# Site URL (used after deployment for links in emails)
NEXT_PUBLIC_SITE_URL=https://www.photarestaurants.com

# Supabase (required for production)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email — Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="Pho Ta <bookings@photarestaurants.com>"

# SMS — Twilio (https://twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Admin dashboard password (change from default!)
ADMIN_PASSWORD=

# Cron job auth — generate with: openssl rand -hex 32
CRON_SECRET=
