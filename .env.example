# Site URL (used in emails, sitemap, SEO)
# Staging on Vercel: https://phota.vercel.app
# Production: https://www.photarestaurants.com
NEXT_PUBLIC_SITE_URL=https://phota.vercel.app

# Supabase (required for production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional but recommended for server-side admin (Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=

# Email — choose Resend OR SMTP (SMTP takes priority when SMTP_HOST is set)
# Force provider: resend | smtp
# EMAIL_PROVIDER=smtp

# Option A: Resend (https://resend.com) — verify your domain for guest emails
RESEND_API_KEY=
EMAIL_FROM="Pho Ta <bookings@photarestaurants.com>"

# Option B: SMTP (Gmail, Google Workspace, etc.)
# Gmail: use an App Password (https://myaccount.google.com/apppasswords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=Phovagrill@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM="Pho Ta <Phovagrill@gmail.com>"

# Staff inbox for new-booking alerts (defaults to owner email)
# STAFF_NOTIFICATION_EMAIL=duydichdanh@gmail.com

# SMS — Twilio (https://twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Admin dashboard password
ADMIN_PASSWORD=123456

# Cron job auth — generate with: openssl rand -hex 32
CRON_SECRET=

# Reminder timing: "daily" (Vercel Hobby, morning-of) or "two_hours" (Pro / external cron)
REMINDER_MODE=daily
